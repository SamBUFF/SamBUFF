{
  "manifest_version": 3,
  "name": "抖音表情包下载器",
  "version": "1.0.0",
  "description": "在抖音网页版扫描已加载的表情，浮层勾选后批量打包下载。",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.byteimg.com/*",
    "*://*.douyinpic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["jszip.min.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
